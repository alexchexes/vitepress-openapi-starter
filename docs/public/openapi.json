{
  "openapi": "3.1.0",
  "info": {
    "title": "Example",
    "version": "1.0.0"
  },
  "paths": {
    "/iplocate/city": {
      "get": {
        "summary": "City by IP (GET)",
        "externalDocs": {
          "url": "https://dadata.es/api/iplocate/"
        },
        "operationId": "ipLocateGet",
        "parameters": [
          {
            "name": "ip",
            "in": "query",
            "description": "IP address to check (description from Parameter Object)",
            "schema": { "$ref": "#/components/schemas/IpAddress" }
          },
          {
            "name": "X-Forwarded-For",
            "in": "header",
            "description": "IP address to check (description from Parameter Object)",
            "schema": { "$ref": "#/components/schemas/IpAddress" }
          },
          {
            "name": "language",
            "in": "query",
            "description": "Results language (description from Parameter Object)",
            "schema": { "$ref": "#/components/schemas/Language" }
          }
        ],
        "responses": { "200": { "description": "OK" } }
      },
      "post": {
        "summary": "City by IP (POST)",
        "externalDocs": {
          "url": "https://dadata.es/api/iplocate/"
        },
        "operationId": "ipLocatePost",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "ip": { "$ref": "#/components/schemas/IpAddress" },
                  "language": { "$ref": "#/components/schemas/Language" }
                }
              }
            }
          }
        },
        "responses": { "200": { "description": "OK" } }
      }
    }
  },
  "components": {
    "schemas": {
      "IpAddress": {
        "type": "string",
        "description": "IP address to check (description from schema)",
        "examples": ["46.226.227.20"]
      },
      "Language": {
        "type": "string",
        "enum": ["es", "en"],
        "description": "Results language (description from schema)",
        "default": "es"
      }
    }
  }
}
